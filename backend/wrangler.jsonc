{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mongolian-typeracer-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-24",
  "durable_objects": {
    "bindings": [
      { "name": "RACE_ROOMS", "class_name": "RaceRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }
  ],
  "vars": {
    "FRONTEND_ORIGIN": "http://localhost:5173"
  },
  "observability": { "enabled": true }
}
