{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:worker": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "predev": "node -e \"require('node:fs').mkdirSync('../frontend/dist', { recursive: true })\""
  },
  "dependencies": {
    "@typeracer/shared": "*",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "typescript": "5.9.3",
    "vitest": "4.1.2",
    "wrangler": "4.61.0"
  }
}
